# Copy this file to .env on the server (docker compose reads .env automatically)
# and adjust it there. .env is gitignored — never commit real secrets.
#
#   cp .env.example .env
#   nano .env

# Full URLs a BROWSER can actually reach — not internal Docker hostnames.
# Must match FRONTEND_URL in the frontend repo's .env, and the API_URL there
# must match MINIO_PUBLIC_URL's host scheme choice (http vs https) for CORS
# and presigned-URL signing to line up.
#
#   Raw IP:port (no reverse proxy):
#     FRONTEND_URL=http://167.86.120.214:3001
#     MINIO_PUBLIC_URL=http://167.86.120.214:9002
#
#   Behind nginx + HTTPS on a real domain:
#     FRONTEND_URL=https://riskycfashion.com
#     MINIO_PUBLIC_URL=https://media.riskycfashion.com
FRONTEND_URL=http://167.86.120.214:3001
MINIO_PUBLIC_URL=http://167.86.120.214:9002

# Host ports (must not collide with anything else already running on the box —
# see `docker ps` before changing these). These are what's used in the raw
# IP:port URLs above; once behind nginx, requests to these ports still need
# to work internally (nginx proxies to 127.0.0.1:<port>), they just don't
# appear in the public-facing URLs anymore.
BACKEND_PORT=8082
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003

# ── Secrets — CHANGE THESE for a real deployment, the defaults are dev-only ──
POSTGRES_PASSWORD=riskyc
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Any long random string — e.g. `openssl rand -base64 48`
JWT_SECRET=cmlza3ljLWZhc2hpb24tZGV2LW9ubHktand0LXNpZ25pbmcta2V5LWNoYW5nZS1pbi1wcm9k

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (Web application). Same value as NEXT_PUBLIC_GOOGLE_CLIENT_ID in the
# frontend repo's .env — used here to verify each Google sign-in token was
# actually issued for this app. Leave blank and Google sign-in still works,
# just without that check (fine for local testing, not for production).
GOOGLE_CLIENT_ID=200363976946-ju1bjgpe114da4gaec0619j4m6k3di90.apps.googleusercontent.com
