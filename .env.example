# Copy this file to .env on the server (docker compose reads .env automatically)
# and adjust it there. .env is gitignored — never commit real secrets.
#
#   cp .env.example .env
#   nano .env

# Full URLs a BROWSER can actually reach — not internal Docker hostnames.
# Must match FRONTEND_URL in the frontend repo's .env, and the API_URL there
# must match MINIO_PUBLIC_URL's host scheme choice (http vs https) for CORS
# and presigned-URL signing to line up.
#
#   Raw IP:port (no reverse proxy):
#     FRONTEND_URL=http://167.86.120.214:3001
#     MINIO_PUBLIC_URL=http://167.86.120.214:9002
#
#   Behind nginx + HTTPS on a real domain:
#     FRONTEND_URL=https://riskycfashion.com
#     MINIO_PUBLIC_URL=https://media.riskycfashion.com
FRONTEND_URL=http://167.86.120.214:3001
MINIO_PUBLIC_URL=http://167.86.120.214:9002

# Host ports (must not collide with anything else already running on the box —
# see `docker ps` before changing these). These are what's used in the raw
# IP:port URLs above; once behind nginx, requests to these ports still need
# to work internally (nginx proxies to 127.0.0.1:<port>), they just don't
# appear in the public-facing URLs anymore.
BACKEND_PORT=8082
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003

# ── Secrets — CHANGE THESE for a real deployment, the defaults are dev-only ──
POSTGRES_PASSWORD=riskyc
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Any long random string — e.g. `openssl rand -base64 48`
JWT_SECRET=cmlza3ljLWZhc2hpb24tZGV2LW9ubHktand0LXNpZ25pbmcta2V5LWNoYW5nZS1pbi1wcm9k

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (Web application). Same value as NEXT_PUBLIC_GOOGLE_CLIENT_ID in the
# frontend repo's .env — used here to verify each Google sign-in token was
# actually issued for this app. Leave blank and Google sign-in still works,
# just without that check (fine for local testing, not for production).
GOOGLE_CLIENT_ID=200363976946-ju1bjgpe114da4gaec0619j4m6k3di90.apps.googleusercontent.com

# Google Cloud Console > APIs & Services > Credentials > Create credentials
# > API key, on a project with the "Cloud Translation API" enabled and
# billing set up (it's a paid, per-character API). Used to auto-translate
# product/category names and descriptions to French when an admin
# creates/edits one. Leave blank and everything still works — French just
# falls back to showing the original text for catalog content.
GOOGLE_TRANSLATE_API_KEY=

# Orange Developer console (console.developer.orange.com) > your application
# > "SMS Cameroon" subscription:
#   ORANGE_SMS_CLIENT_ID / ORANGE_SMS_CLIENT_SECRET — Credentials tab of the subscription
#   ORANGE_SMS_SENDER_NUMBER — for Cameroon this is the FIXED, documented
#     value 2370000 (per Orange's own country table — same for every
#     Cameroon account, not specific to yours). NOT your personal phone
#     number, and NOT the "SMS <number>" label shown under Authorized
#     senders (that's a sender *name*, not this).
#   ORANGE_SMS_SENDER_NAME — OPTIONAL: your approved custom sender name (max
#     11 chars, letters/numbers/spaces), requested via the "Request custom
#     Sender Names" form (takes Orange's marketing team a few days to
#     approve) — leave blank until then and messages just show the numeric
#     sender above instead of a name
# Sent alongside push notifications when an order is validated/rejected, so
# the customer is reached even without push enabled. Leave CLIENT_ID/SECRET/
# SENDER_NUMBER blank and SMS sending is skipped entirely — nothing else is
# affected.
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER_NUMBER=
ORANGE_SMS_SENDER_NAME=

# Twilio SMS — an alternative to Orange above; PREFERRED over it when both
# are set (never both at once, so this doesn't double the SMS cost of an
# order). How to set up:
#   1. Sign up at twilio.com — a free trial account works for initial
#      testing (comes with some trial credit).
#   2. Console home page (twilio.com/console) shows your Account SID and
#      Auth Token right on the dashboard — copy both.
#   3. Decide on TWILIO_FROM (the sender identity), one of:
#      a) A Twilio phone number (Console > Phone Numbers > Buy a number) —
#         works immediately, in E.164 format e.g. "+15017122661". BUT per
#         Twilio's own Cameroon SMS guidelines, a plain numeric sender is
#         REJECTED outright for MTN Cameroon recipients (Orange Cameroon
#         recipients are fine). Use this to test against an Orange number
#         while the option below is pending approval.
#      b) An Alphanumeric Sender ID (e.g. "RiskycFash", max 11 chars) —
#         reaches both carriers, but for Cameroon this REQUIRES
#         pre-registration in the Twilio Console (search "Alphanumeric
#         Sender ID"), which takes about 3 weeks to approve. This is the
#         one to use for the real branded sender long-term.
#   4. IMPORTANT while still on a trial account: Twilio will only deliver
#      to phone numbers you've manually verified under Console > Phone
#      Numbers > Verified Caller IDs. Add a payment method (upgrading out
#      of trial) to send to arbitrary customer numbers in production.
# Leave any of these blank and Twilio is skipped (Orange above is used
# instead, if that's configured; otherwise no SMS is sent).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
